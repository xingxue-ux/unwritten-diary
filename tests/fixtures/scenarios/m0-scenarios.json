{
  "schemaVersion": 1,
  "contractVersion": "v1",
  "source": "docs/development/01-共享接口契约.md 第 9 节",
  "note": "所有资料均为虚构。步骤使用契约里的方法名，expected 写成可判定的断言。requiresRealDevice 为 true 的场景不得用模拟器或桌面结果代替验收。",
  "scenarios": [
    {
      "id": "empty-library",
      "name": "空库首次使用",
      "goal": "首次安装、未配置任何远端模型时，用户能立刻创建并保存本地记录，模型配置不是入口阻断",
      "requiresRealDevice": false,
      "setup": {
        "library": "empty",
        "providerConfigured": false,
        "clock": "2026-09-27T09:00:00Z",
        "timeZone": "Asia/Shanghai",
        "injected": []
      },
      "steps": [
        "core.open(null)",
        "core.snapshot",
        "captures.createDraft(occurredAt=null)",
        "captures.saveDraft(text=\"今天下午面试完，走出大楼的时候风很大。\")",
        "captures.commit",
        "core.close",
        "core.open(null)",
        "search.start(mode=keyword, query=\"面试\")"
      ],
      "expected": {
        "durableTrueOnSave": true,
        "captureState": "committed",
        "survivesRestart": true,
        "keywordSearchReturnsTheCapture": true,
        "diaryGenerationBlocked": false,
        "providerTasksGoTo": "waiting_configuration",
        "noFabricatedDiary": true
      },
      "covers": ["E01", "E02"]
    },
    {
      "id": "text-only-day",
      "name": "纯文字一天",
      "goal": "一天多条纯文字记录，能正确归属到同一 dayKey，整理出的正文是自然段而不是要点列表",
      "requiresRealDevice": false,
      "setup": {
        "library": "seeded-text",
        "providerConfigured": true,
        "clock": "2026-09-27T22:30:00Z",
        "timeZone": "Asia/Shanghai",
        "injected": []
      },
      "steps": [
        "captures.createDraft/saveDraft/commit 三次（09:12、14:40、21:05）",
        "core.snapshot",
        "diary.generate(dayKey=2026-09-27, reason=manual)",
        "diary.getDay(dayKey=2026-09-27)",
        "diary.getVersion(versionId=currentVersionId)"
      ],
      "expected": {
        "dayKeyOfAllCaptures": "2026-09-27",
        "orderedByOccurredAt": true,
        "bodyIsParagraphs": true,
        "bodyHasNoBulletList": true,
        "bodyHasNoHeadings": true,
        "firstGenerationBecomesCurrent": true,
        "sourceSnapshotListsAllThreeCaptures": true
      },
      "covers": ["E02", "E25"]
    },
    {
      "id": "mixed-media-day",
      "name": "图文混合一天",
      "goal": "同一条记录里同时有文字、图片、音频和文件时，顺序、状态与原件关系都正确，且导入后删除外部原文件不影响资料库",
