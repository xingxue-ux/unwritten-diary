{
  "app": {
    // 参考工程的临时 bundleName（不是产品最终值）。要与调试 Profile（.p7b）里的
    // bundle-info.bundle-name 一致才能安装，见 probes/ohos-hap-smoke/README.md。
    "bundleName": "com.lingxing.unwrittendiary",
    "vendor": "xingxue",
    // 1.0.3：移除随包本机整理（Qwen3.5-0.8B + llama.cpp）。这是功能回退——日记生成
    // 必须配置在线服务——用新版本号区分升级路径与商店记录。
    "versionCode": 1000003,
    "versionName": "1.0.3",
    "buildVersion": "1",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
