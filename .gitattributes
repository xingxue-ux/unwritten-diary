# 跨平台行尾：文本文件一律按 LF 入库、LF 检出，保证任何机器 checkout 的字节
# 与 CI 一致。插件包的 packageHashes 是按磁盘字节算的 SHA-256，行尾漂移会直接
# 让示例安装失败（Windows 默认 core.autocrlf=true 就会踩到）。
* text=auto eol=lf

# 二进制不参与行尾转换。Git 也能按内容自动识别，这里把常见类型显式钉死。
*.wasm    binary
*.png     binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.onnx    binary
*.zip     binary
*.gz      binary
*.db      binary
*.sqlite  binary

# 设备证据是原样抓取的日志字节（含 CRLF），不要被 renormalize 改写。
probes/**/evidence/*.txt -text

# 插件示例是随仓库分发的示例包：即使以后全局策略调整，这里也必须逐字节稳定。
plugins/examples/**/*.wat  text eol=lf
plugins/examples/**/*.md   text eol=lf
plugins/examples/**/*.json text eol=lf
plugins/examples/**/*.wasm binary
